{
  "problemMatcher": [
    {
      "owner": "focus-markdown-lint",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(.+\\.md):(\\d+):(\\d+):\\s+(MD\\d+):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      ]
    }
  ]
}
