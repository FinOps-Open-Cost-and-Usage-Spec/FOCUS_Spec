{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCR Schema with Stage 2 Enhancements",
  "type": "object",
  "properties": {
    "SCRDetails": {
      "type": "object",
      "description": "Metadata about the SCR version and general properties.",
      "properties": {
        "Version": {
          "type": "string"
        }
      },
      "required": [
        "Version"
      ],
      "additionalProperties": false
    },
    "PreConditions": {
      "type": "object",
      "description": "A dictionary of precondition flags used to determine rule applicability.",
      "patternProperties": {
        "^[A-Z0-9_]+$": {
          "type": "object",
          "properties": {
            "Description": {
              "type": "string"
            }
          },
          "required": [
            "Description"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "Attributes": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9]+-A-\\d{3}-[MOC]$": {
          "type": "object",
          "properties": {
            "Rules": {
              "type": "object",
              "properties": {
                "Operator": {
                  "type": "string",
                  "enum": [
                    "AND",
                    "OR",
                    "NOT"
                  ]
                },
                "Items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "Operator",
                "Items"
              ]
            }
          },
          "required": [
            "Rules"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "AttributeChecks": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9]+-A-\\d{3}-[MOC]$": {
          "type": "object",
          "properties": {
            "Function": {
              "type": "string",
              "enum": [
                "Presence",
                "Validation",
                "Format",
                "Type",
                "Conditional",
                "Composite"
              ]
            },
            "Reference": {
              "type": "string"
            },
            "Notes": {
              "type": "string"
            },
            "VersionIntroduced": {
              "type": "string"
            },
            "Status": {
              "type": "string",
              "enum": [
                "active",
                "provisional",
                "deprecated"
              ]
            },
            "ValidationCriteria": {
              "type": "object",
              "properties": {
                "mustSatisfy": {
                  "type": "string"
                }
              },
              "required": [
                "mustSatisfy"
              ],
              "additionalProperties": true
            }
          },
          "required": [
            "Function",
            "Reference",
            "VersionIntroduced",
            "Status",
            "ValidationCriteria"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "CheckFunction": {
      "type": "object",
      "description": "Reusable check functions used in validation logic (e.g., AND, OR, ColumnPresent).",
      "patternProperties": {
        "^[A-Za-z0-9_]+$": {
          "type": "object",
          "properties": {
            "Arguments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "FormatAttributes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "Arguments",
            "FormatAttributes"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ConformanceTables": {
      "type": "object",
      "description": "Top-level groupings (like FOCUS) mapping to sets of rule IDs.",
      "patternProperties": {
        "^[A-Z0-9_]+$": {
          "type": "object",
          "properties": {
            "ConformanceRuleSets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "ConformanceRuleSets"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ConformanceRuleSets": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9]+-C-\\d{3}-[MOC]$": {
          "type": "object",
          "properties": {
            "Type": {
              "type": "string"
            },
            "Rules": {
              "type": "object",
              "properties": {
                "Operator": {
                  "type": "string",
                  "enum": [
                    "AND",
                    "OR",
                    "NOT"
                  ]
                },
                "Items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "Operator",
                "Items"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "Type",
            "Rules"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ConformanceRules": {
      "type": "array",
      "description": "The list of all atomic rules, each containing logic, reference metadata, and criteria.",
      "items": {
        "type": "object",
        "patternProperties": {
          "^[A-Za-z0-9]+-C-\\d{3}-[MOC]$": {
            "type": "object",
            "properties": {
              "Function": {
                "type": "string",
                "enum": [
                  "Presence",
                  "Validation",
                  "Format",
                  "Type",
                  "Conditional",
                  "Composite"
                ]
              },
              "Reference": {
                "type": "string"
              },
              "Notes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "VersionIntroduced": {
                "type": "string"
              },
              "Status": {
                "type": "string",
                "enum": [
                  "active",
                  "provisional",
                  "deprecated"
                ]
              },
              "PreConditions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ValidationCriteria": {
                "type": "object",
                "properties": {
                  "mustSatisfy": {
                    "type": "string"
                  },
                  "Check": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "properties": {
                      "operator": {
                        "type": "string",
                        "enum": [
                          "==",
                          "!=",
                          "IN",
                          "NOT IN",
                          "IS NULL",
                          "IS NOT NULL",
                          ">",
                          "<",
                          ">=",
                          "<="
                        ]
                      },
                      "left": {
                        "type": "string"
                      },
                      "right": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "operator",
                      "left",
                      "right"
                    ],
                    "additionalProperties": false
                  },
                  "Condition": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "properties": {
                      "operator": {
                        "type": "string",
                        "enum": [
                          "==",
                          "!=",
                          "IN",
                          "NOT IN",
                          "IS NULL",
                          "IS NOT NULL",
                          ">",
                          "<",
                          ">=",
                          "<="
                        ]
                      },
                      "left": {
                        "type": "string"
                      },
                      "right": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "operator",
                      "left",
                      "right"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "mustSatisfy"
                ],
                "additionalProperties": true
              },
              "DisplayOrder": {
                "type": "integer"
              },
              "SourceText": {
                "type": "string"
              },
              "ColumnID": {
                "type": "string"
              }
            },
            "required": [
              "Function",
              "Reference",
              "VersionIntroduced",
              "Status",
              "PreConditions",
              "ValidationCriteria",
              "ColumnID"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "Requirement": {
      "type": "object",
      "description": "Logical composition of SCR rule references for composite evaluation.",
      "properties": {
        "Operator": {
          "type": "string",
          "enum": [
            "AND",
            "OR",
            "NOT"
          ]
        },
        "Items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "Operator",
        "Items"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "SCRDetails",
    "PreConditions",
    "Attributes",
    "AttributeChecks",
    "CheckFunction",
    "ConformanceTables",
    "ConformanceRuleSets",
    "ConformanceRules",
    "Requirement"
  ],
  "additionalProperties": false
}