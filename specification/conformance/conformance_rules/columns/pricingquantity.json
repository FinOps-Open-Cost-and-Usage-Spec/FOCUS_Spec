  "PricingQuantity-C-010-C": {
    "Function": "Validation",
    "Reference": "Pricing Quantity",
    "EntityType": "Column",
    "Notes": "Product of PricingQuantity and unit price must match corresponding cost metric when unit price is not null and ChargeClass is not Correction",
    "CRVersionIntroduced": "1.2",
    "Status": "Active",
    "ApplicabilityCriteria": [
      "Dataset includes PricingQuantity column"
    ],
    "Type": "Dynamic",
    "ValidationCriteria": {
      "MustSatisfy": "The product of PricingQuantity and a unit price (e.g., ContractedUnitPrice) MUST match the corresponding cost metric (e.g., ContractedCost) when the unit price is not null and ChargeClass is not \"Correction\".",
      "Keyword": "MUST",
      "Requirement": {
        "CheckFunction": "ProductMatches",
        "Items": [
          {
            "CheckFunction": "Multiply",
            "ColumnName1": "PricingQuantity",
            "ColumnName2": "ContractedUnitPrice"
          },
          {
            "CheckFunction": "Equal",
            "ColumnName": "ContractedCost"
          }
        ]
      },
      "Condition": {
        "CheckFunction": "AND",
        "Items": [
          {
            "CheckFunction": "IsNotNull",
            "ColumnName": "ContractedUnitPrice"
          },
          {
            "CheckFunction": "NotEqual",
            "ColumnName": "ChargeClass",
            "Value": "Correction"
          }
        ]
      },
      "Dependencies": [
        "ContractedUnitPrice:CR",
        "ContractedCost:CR",
        "AttributeID:ChargeClass"
      ]
    }
  },
  "PricingQuantity-C-011-C": {
    "Function": "Validation",
    "Reference": "Pricing Quantity",
    "EntityType": "Column",
    "Notes": "Discrepancies may exist in PricingQuantity, unit prices, or costs when ChargeClass is Correction",
    "CRVersionIntroduced": "1.2",
    "Status": "Active",
    "ApplicabilityCriteria": [
      "Dataset includes PricingQuantity column"
    ],
    "Type": "Dynamic",
    "ValidationCriteria": {
      "MustSatisfy": "Discrepancies in PricingQuantity, unit prices (e.g., ContractedUnitPrice), or costs (e.g., ContractedCost) MAY exist when ChargeClass is \"Correction\".",
      "Keyword": "MAY",
      "Requirement": {
        "CheckFunction": "Optional",
        "Items": [
          "PricingQuantity",
          "ContractedUnitPrice",
          "ContractedCost"
        ]
      },
      "Condition": {
        "CheckFunction": "Equal",
        "ColumnName": "ChargeClass",
        "Value": "Correction"
      },
      "Dependencies": [
        "ContractedUnitPrice:CR",
        "ContractedCost:CR",
        "AttributeID:ChargeClass"
      ]
    }
  }
