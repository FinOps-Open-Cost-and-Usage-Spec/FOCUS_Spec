  "PricingQuantity-C-005-C": {
    "Function": "NullabilityRules",
    "Reference": "Pricing Quantity",
    "EntityType": "Column",
    "Notes": "PricingQuantity must be null when ChargeCategory is Tax",
    "CRVersionIntroduced": "1.2",
    "Status": "Active",
    "ApplicabilityCriteria": [
      "Dataset includes PricingQuantity column"
    ],
    "Type": "Dynamic",
    "ValidationCriteria": {
      "MustSatisfy": "PricingQuantity MUST be null when ChargeCategory is \"Tax\".",
      "Keyword": "MUST",
      "Requirement": {
        "CheckFunction": "IsNull",
        "ColumnName": "PricingQuantity"
      },
      "Condition": {
        "CheckFunction": "Equal",
        "ColumnName": "ChargeCategory",
        "Value": "Tax"
      },
      "Dependencies": [
        "AttributeID:ChargeCategory"
      ]
    }
  },
  "PricingQuantity-C-006-C": {
    "Function": "NullabilityRules",
    "Reference": "Pricing Quantity",
    "EntityType": "Column",
    "Notes": "PricingQuantity must not be null when ChargeCategory is Usage or Purchase and ChargeClass is not Correction",
    "CRVersionIntroduced": "1.2",
    "Status": "Active",
    "ApplicabilityCriteria": [
      "Dataset includes PricingQuantity column"
    ],
    "Type": "Dynamic",
    "ValidationCriteria": {
      "MustSatisfy": "PricingQuantity MUST NOT be null when ChargeCategory is \"Usage\" or \"Purchase\" and ChargeClass is not \"Correction\".",
      "Keyword": "MUST NOT",
      "Requirement": {
        "CheckFunction": "IsNotNull",
        "ColumnName": "PricingQuantity"
      },
      "Condition": {
        "CheckFunction": "AND",
        "Items": [
          {
            "CheckFunction": "OR",
            "Items": [
              {
                "CheckFunction": "Equal",
                "ColumnName": "ChargeCategory",
                "Value": "Usage"
              },
              {
                "CheckFunction": "Equal",
                "ColumnName": "ChargeCategory",
                "Value": "Purchase"
              }
            ]
          },
          {
            "CheckFunction": "NotEqual",
            "ColumnName": "ChargeClass",
            "Value": "Correction"
          }
        ]
      },
      "Dependencies": [
        "AttributeID:ChargeCategory",
        "AttributeID:ChargeClass"
      ]
    }
  },
