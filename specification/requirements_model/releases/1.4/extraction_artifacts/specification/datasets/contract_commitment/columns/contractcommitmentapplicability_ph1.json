    },
    {
      "temp_id": "R022",
      "order": 22,
      "text": "The evaluation of **Applicability** percentages must be contextually aligned with the [Contract Commitment Model](#datasets.contractcommitment.contractcommitmentmodel) and [Contract Commitment Fulfillment Interval](#datasets.contractcommitment.contractcommitmentfulfillmentinterval):",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Contract Commitment Applicability",
        "Implementation Guidance",
        "Integration with Commitment Logic"
      ],
      "block": {
        "block_type": "paragraph",
        "indent_level": 0,
        "bullet": null
