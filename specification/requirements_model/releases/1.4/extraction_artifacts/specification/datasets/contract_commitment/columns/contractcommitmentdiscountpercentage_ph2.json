  "0_outline_root": "ROOT: Contract Commitment Discount Percentage > Requirements",
  "0_outline_lines": [
    "L034: \"ContractCommitmentDiscountPercentage MUST adhere to the following requirements:\"",
    "  L036: \"ContractCommitmentDiscountPercentage MUST be of type Decimal.\"",
    "  L037: \"ContractCommitmentDiscountPercentage MUST conform to [NumericFormat](#attributes.numericformat) requirements.\"",
    "  L038: \"ContractCommitmentDiscountPercentage MUST adhere to the following nullability requirements:\"",
    "    L039: \"ContractCommitmentDiscountPercentage MUST NOT be null when [ContractCommitmentBenefitCategory](#datasets.contractcommitment.contractcommitmentbenefitcategory) is \\\"Discount\\\".\"",
    "    L040: \"ContractCommitmentDiscountPercentage MUST be null when ContractCommitmentBenefitCategory is \\\"Availability\\\".\"",
    "  L041: \"ContractCommitmentDiscountPercentage MUST be a value between 0.0 and 1.0, inclusive.\"",
    "  L042: \"For contracts with multiple tiers (e.g., 5% discount up to 1M, 10% above 1M), ContractCommitmentDiscountPercentage MUST adhere to the following additional requirements:\"",
    "    L043: \"ContractCommitmentDiscountPercentage MUST reflect the discount percentage defined for the specific pricing tier represented by the Contract Commitment row.\"",
    "    L044: \"ContractCommitmentDiscountPercentage MUST correspond to only one pricing tier per Contract Commitment row.\"",
    "  L045: \"ContractCommitmentDiscountPercentage SHOULD represent the net effective discount when multiple contractual layers are applicable (e.g., a negotiated discount on top of a standard commitment).\""
  ],
