  "0_outline_root": "ROOT: Contract Commitment Applicability Object > Requirements",
  "0_outline_lines": [
    "L009: \"ContractCommitmentApplicabilityObject MUST adhere to the following requirements:\"",
    "  L011: \"ContractCommitmentApplicabilityObject MUST conform to the [ContractCommitmentApplicabilityObjectSchema](#schemas.contractcommitment.contractcommitmentapplicabilityobjectschema) JSON Schema.\"",
    "  L012: \"ContractCommitmentApplicabilityObject.IsGlobalScope MUST be `true` if the *contract commitment* applies to all entities.\"",
    "  L013: \"ContractCommitmentApplicabilityObject.IsComplexScope MUST be `true` if the *contract commitment's* applicability logic exceeds schema capabilities.\"",
    "  L014: \"ContractCommitmentApplicabilityObject.Applicability.Cost MUST represent the fraction of an eligible charge's cost that is applicable to the commitment (0.0 to 1.0).\"",
    "  L015: \"ContractCommitmentApplicabilityObject.Applicability.Usage MUST represent the fraction of an eligible charge's usage that is applicable to the commitment (0.0 to 1.0).\"",
    "  L016: \"ContractCommitmentApplicabilityObject.Inclusions[\\\\*].Applicability.Cost MUST represent the fraction of an eligible charge's cost that is applicable to the commitment (0.0 to 1.0).\"",
    "  L017: \"ContractCommitmentApplicabilityObject.Inclusions[\\\\*].Applicability.Usage MUST represent the fraction of an eligible charge's usage that is applicable to the commitment (0.0 to 1.0).\"",
    "  L018: \"ContractCommitmentApplicabilityObject.Inclusions[\\\\*].Dimension SHOULD represent a column in [Cost and Usage](#datasets.costandusage).\"",
    "  L019: \"ContractCommitmentApplicabilityObject.Exclusions[\\\\*].Dimension SHOULD represent a column in [Cost and Usage](#datasets.costandusage).\"",
    "  L020: \"ContractCommitmentApplicabilityObject.Inclusions[\\\\*].Values MUST contain only the single string \\\"*\\\" if the wildcard is present.\"",
    "  L021: \"ContractCommitmentApplicabilityObject.Exclusions[\\\\*].Values MUST contain only the single string \\\"*\\\" if the wildcard is present.\""
  ],
