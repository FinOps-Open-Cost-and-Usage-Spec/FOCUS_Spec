  "0_outline_root": "ROOT: Contract Commitment > Requirements",
  "0_outline_lines": [
    "L053: \"ContractCommitment MUST adhere to the following requirements:\"",
    "  L055: \"ContractCommitment MUST be present when the service provider supports *contract commitments*.\"",
    "  L056: \"ContractCommitment column presence MUST adhere to the following requirements:\"",
    "    L057: \"ContractCommitment MUST include [BillingCurrency](#datasets.contractcommitment.billingcurrency).\"",
    "    L058: \"ContractCommitment MUST include [ContractCommitmentApplicability](#datasets.contractcommitment.contractcommitmentapplicability).\"",
    "    L059: \"ContractCommitment MUST include [ContractCommitmentBenefitCategory](#datasets.contractcommitment.contractcommitmentbenefitcategory).\"",
    "    L060: \"ContractCommitment MUST include [ContractCommitmentCategory](#datasets.contractcommitment.contractcommitmentcategory).\"",
    "    L061: \"ContractCommitment MUST include [ContractCommitmentCost](#datasets.contractcommitment.contractcommitmentcost).\"",
    "    L062: \"ContractCommitment MUST include [ContractCommitmentCreated](#datasets.contractcommitment.contractcommitmentcreated).\"",
    "    L063: \"ContractCommitment MUST include [ContractCommitmentDescription](#datasets.contractcommitment.contractcommitmentdescription).\"",
    "    L064: \"ContractCommitment MUST include [ContractCommitmentDiscountPercentage](#datasets.contractcommitment.contractcommitmentdiscountpercentage).\"",
    "    L065: \"ContractCommitment MUST include [ContractCommitmentDurationType](#datasets.contractcommitment.contractcommitmentdurationtype).\"",
    "    L066: \"ContractCommitment MUST include [ContractCommitmentFulfillmentInterval](#datasets.contractcommitment.contractcommitmentfulfillmentinterval).\"",
    "    L067: \"ContractCommitment MUST include [ContractCommitmentId](#datasets.contractcommitment.contractcommitmentid).\"",
    "    L068: \"ContractCommitment MUST include [ContractCommitmentLastUpdated](#datasets.contractcommitment.contractcommitmentlastupdated).\"",
    "    L069: \"ContractCommitment MUST include [ContractCommitmentLifecycleStatus](#datasets.contractcommitment.contractcommitmentlifecyclestatus).\"",
    "    L070: \"ContractCommitment MUST include [ContractCommitmentModel](#datasets.contractcommitment.contractcommitmentmodel).\"",
    "    L071: \"ContractCommitment MUST include [ContractCommitmentOfferCategory](#datasets.contractcommitment.contractcommitmentoffercategory).\"",
    "    L072: \"ContractCommitment MUST include [ContractCommitmentPaymentInterval](#datasets.contractcommitment.contractcommitmentpaymentinterval).\"",
    "    L073: \"ContractCommitment MUST include [ContractCommitmentPaymentModel](#datasets.contractcommitment.contractcommitmentpaymentmodel).\"",
    "    L074: \"ContractCommitment MUST include [ContractCommitmentPaymentUpfrontPercentage](#datasets.contractcommitment.contractcommitmentpaymentupfrontpercentage) if the service provider offers \\\"Partial Upfront\\\" [payment models](#datasets.contractcommitment.contractcommitmentpaymentmodel).\"",
    "    L075: \"ContractCommitment MUST include [ContractCommitmentPeriodEnd](#datasets.contractcommitment.contractcommitmentperiodend).\"",
    "    L076: \"ContractCommitment MUST include [ContractCommitmentPeriodStart](#datasets.contractcommitment.contractcommitmentperiodstart).\"",
    "    L077: \"ContractCommitment MUST include [ContractCommitmentQuantity](#datasets.contractcommitment.contractcommitmentquantity).\"",
    "    L078: \"ContractCommitment MUST include [ContractCommitmentType](#datasets.contractcommitment.contractcommitmenttype).\"",
    "    L079: \"ContractCommitment MUST include [ContractCommitmentUnit](#datasets.contractcommitment.contractcommitmentunit).\"",
    "    L080: \"ContractCommitment MUST include [ContractId](#datasets.contractcommitment.contractid).\"",
    "    L081: \"ContractCommitment MUST include [ContractPeriodEnd](#datasets.contractcommitment.contractperiodend).\"",
    "    L082: \"ContractCommitment MUST include [ContractPeriodStart](#datasets.contractcommitment.contractperiodstart).\"",
    "    L083: \"ContractCommitment MUST include [InvoiceIssuerName](#datasets.contractcommitment.invoiceissuername).\"",
    "    L084: \"ContractCommitment MUST include [PricingCurrency](#datasets.contractcommitment.pricingcurrency) when the service provider supports pricing and billing in different currencies.\"",
    "    L085: \"ContractCommitment MUST include [PricingCurrencyContractCommitmentCost](#datasets.contractcommitment.pricingcurrencycontractcommitmentcost) when the service provider supports pricing and billing in different currencies.\"",
    "    L086: \"ContractCommitment MUST include [ServiceProviderName](#datasets.contractcommitment.serviceprovidername).\"",
    "  L087: \"ContractCommitment MUST conform to [ColumnHandling](#attributes.columnhandling) requirements.\"",
    "  L088: \"ContractCommitment MUST conform to [DatasetCompleteness](#attributes.datasetcompleteness) requirements.\"",
    "  L089: \"ContractCommitment MUST conform to [NullHandling](#attributes.nullhandling) requirements.\"",
    "  L090: \"ContractCommitment MUST conform to [DatasetConfiguration](#attributes.datasetconfiguration) requirements.\""
  ],
