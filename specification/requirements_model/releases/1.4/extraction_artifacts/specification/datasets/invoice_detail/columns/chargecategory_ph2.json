  "0_outline_root": "ROOT: Charge Category > Requirements",
  "0_outline_lines": [
    "L007: \"ChargeCategory MUST adhere to the following requirements:\"",
    "  L009: \"ChargeCategory MUST be of type String.\"",
    "  L010: \"ChargeCategory MUST NOT be null.\"",
    "  L011: \"ChargeCategory MUST be one of the allowed values.\"",
    "  L012: \"When the *charge* does not aggregate multiple classifications, ChargeCategory MUST adhere to the following requirements:\"",
    "    L013: \"ChargeCategory MUST be \\\"Usage\\\" when the *charge* represents consumption of a service or resource.\"",
    "    L014: \"ChargeCategory MUST be \\\"Purchase\\\" when the *charge* represents acquisition of a service, resource, or *commitment*.\"",
    "    L015: \"ChargeCategory MUST be \\\"Tax\\\" when the *charge* represents taxes levied by the relevant authorities.\"",
    "    L016: \"ChargeCategory MUST be \\\"Credit\\\" when the *charge* represents a financial incentive or allowance unrelated to other *charges*.\"",
    "    L017: \"ChargeCategory MUST be \\\"Adjustment\\\" when the *charge* represents a billing modification that does not fall into other ChargeCategories.\"",
    "  L018: \"When the *charge* aggregates multiple classifications, ChargeCategory MUST adhere to the following requirements:\"",
    "    L019: \"ChargeCategory MAY be \\\"Usage\\\" when the record aggregates *charges* across multiple allowed values other than \\\"Tax\\\" (e.g., aggregation of \\\"Usage\\\" and \\\"Credit\\\" is allowed, but not \\\"Usage\\\" and \\\"Tax\\\").\""
  ],
