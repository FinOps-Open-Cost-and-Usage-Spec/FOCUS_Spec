  "0_outline_root": "ROOT: Invoice Detail > Requirements",
  "0_outline_lines": [
    "L047: \"InvoiceDetail MUST adhere to the following requirements:\"",
    "  L049: \"InvoiceDetail MUST be present if the invoice issuer supports payable invoices.\"",
    "  L050: \"The presence of columns in InvoiceDetail MUST adhere to the following requirements:\"",
    "    L051: \"InvoiceDetail MUST include [BilledCost](#datasets.invoicedetail.billedcost).\"",
    "    L052: \"InvoiceDetail MUST include [BillingAccountId](#datasets.invoicedetail.billingaccountid).\"",
    "    L053: \"InvoiceDetail MUST include [BillingCurrency](#datasets.invoicedetail.billingcurrency).\"",
    "    L054: \"InvoiceDetail MUST include [BillingPeriodEnd](#datasets.invoicedetail.billingperiodend).\"",
    "    L055: \"InvoiceDetail MUST include [BillingPeriodStart](#datasets.invoicedetail.billingperiodstart).\"",
    "    L056: \"InvoiceDetail MUST include [ChargeCategory](#datasets.invoicedetail.chargecategory).\"",
    "    L057: \"InvoiceDetail MUST include [InvoiceDetailCreated](#datasets.invoicedetail.invoicedetailcreated).\"",
    "    L058: \"InvoiceDetail MUST include [InvoiceDetailDescription](#datasets.invoicedetail.invoicedetaildescription).\"",
    "    L059: \"InvoiceDetail MUST include [InvoiceDetailGrain](#datasets.invoicedetail.invoicedetailgrain).\"",
    "    L060: \"InvoiceDetail MUST include [InvoiceDetailId](#datasets.invoicedetail.invoicedetailid).\"",
    "    L061: \"InvoiceDetail MUST include [InvoiceDetailLastUpdated](#datasets.invoicedetail.invoicedetaillastupdated).\"",
    "    L062: \"InvoiceDetail MUST include [InvoiceId](#datasets.invoicedetail.invoiceid).\"",
    "    L063: \"InvoiceDetail MUST include [InvoiceIssueDate](#datasets.invoicedetail.invoiceissuedate).\"",
    "    L064: \"InvoiceDetail MUST include [InvoiceIssueStatus](#datasets.invoicedetail.invoiceissuestatus).\"",
    "    L065: \"InvoiceDetail MUST include [InvoiceIssuerName](#datasets.invoicedetail.invoiceissuername).\"",
    "    L066: \"InvoiceDetail MUST include [PaymentCurrency](#datasets.invoicedetail.paymentcurrency) if the invoice issuer supports billing and payment in different currencies.\"",
    "    L067: \"InvoiceDetail MUST include [PaymentCurrencyBilledCost](#datasets.invoicedetail.paymentcurrencybilledcost) if the invoice issuer supports billing and payment in different currencies.\"",
    "    L068: \"InvoiceDetail MUST include [PaymentCurrencyInvoiceDetailId](#datasets.invoicedetail.paymentcurrencyinvoicedetailid) if the invoice issuer represents billing currency and payment currency at different aggregation levels on payable invoices.\"",
    "    L069: \"InvoiceDetail MUST include [PaymentDueDate](#datasets.invoicedetail.paymentduedate).\"",
    "    L070: \"InvoiceDetail MUST include [PaymentTerms](#datasets.invoicedetail.paymentterms).\"",
    "    L071: \"InvoiceDetail MUST include [PurchaseOrderNumber](#datasets.invoicedetail.purchaseordernumber) if the invoice issuer supports customer input of purchase order numbers.\"",
    "    L072: \"InvoiceDetail MUST include [ReferenceInvoiceId](#datasets.invoicedetail.referenceinvoiceid).\"",
    "  L073: \"InvoiceDetail MUST conform to [ColumnHandling](#attributes.columnhandling) requirements.\"",
    "  L074: \"InvoiceDetail MUST conform to [DatasetCompleteness](#attributes.datasetcompleteness) requirements.\"",
    "  L075: \"InvoiceDetail MUST conform to [NullHandling](#attributes.nullhandling) requirements.\"",
    "  L076: \"InvoiceDetail MUST conform to [InvoiceHandling](#attributes.invoicehandling) requirements.\"",
    "  L077: \"InvoiceDetail MUST represent all invoice line items with a non-zero [BilledCost](#datasets.invoicedetail.billedcost) on any invoice associated with a [BillingAccountId](#datasets.invoicedetail.billingaccountid).\"",
    "  L078: \"InvoiceDetail documentation MUST adhere to the following requirements:\"",
    "    L079: \"InvoiceDetail documentation MUST specify how InvoiceDetail records correspond to invoice line items.\"",
    "    L080: \"InvoiceDetail documentation MUST specify whether invoice line items with BilledCost of 0 are excluded from InvoiceDetail.\"",
    "    L081: \"InvoiceDetail documentation MUST describe how columns in the CostAndUsage and InvoiceDetail datasets represent the invoice issuer's invoice reconciliation process.\"",
    "    L082: \"InvoiceDetail documentation MUST be freely accessible to FOCUS consumers.\""
  ],
