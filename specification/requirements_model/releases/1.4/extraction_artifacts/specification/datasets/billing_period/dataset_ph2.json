  "0_outline_root": "ROOT: Billing Period > Requirements",
  "0_outline_lines": [
    "L027: \"BillingPeriod MUST adhere to the following requirements:\"",
    "  L029: \"BillingPeriod MUST be present when the invoice issuer supports payable invoices.\"",
    "  L030: \"The presence of columns in BillingPeriod MUST adhere to the following requirements:\"",
    "    L031: \"BillingPeriod MUST include [BillingPeriodCreated](#datasets.billingperiod.billingperiodcreated).\"",
    "    L032: \"BillingPeriod MUST include [BillingPeriodEnd](#datasets.billingperiod.billingperiodend).\"",
    "    L033: \"BillingPeriod MUST include [BillingPeriodLastUpdated](#datasets.billingperiod.billingperiodlastupdated).\"",
    "    L034: \"BillingPeriod MUST include [BillingPeriodStart](#datasets.billingperiod.billingperiodstart).\"",
    "    L035: \"BillingPeriod MUST include [BillingPeriodStatus](#datasets.billingperiod.billingperiodstatus).\"",
    "    L036: \"BillingPeriod MUST include [InvoiceIssuerName](#datasets.billingperiod.invoiceissuername).\"",
    "  L037: \"BillingPeriod MUST conform to [ColumnHandling](#attributes.columnhandling) requirements.\"",
    "  L038: \"BillingPeriod MUST conform to [CorrectionHandling](#attributes.correctionhandling) requirements.\"",
    "  L039: \"BillingPeriod MUST conform to [DatasetCompleteness](#attributes.datasetcompleteness) requirements.\"",
    "  L040: \"BillingPeriod MUST conform to [DatasetConfiguration](#attributes.datasetconfiguration) requirements.\"",
    "  L041: \"BillingPeriod MUST conform to [DeliveryHandling](#attributes.deliveryhandling) requirements.\""
  ],
