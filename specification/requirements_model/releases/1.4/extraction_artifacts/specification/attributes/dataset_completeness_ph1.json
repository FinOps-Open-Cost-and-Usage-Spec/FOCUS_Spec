      },
      "_alignment_status": "confirmed",
      "ref": "L016"
    },
    {
      "temp_id": "R008",
      "order": 8,
      "text": "*FOCUS dataset* MUST retain the fidelity of corresponding *native dataset* values within *custom columns* without lossy transformations (e.g., rounding or truncation).",
      "keyword": "MUST",
      "role": "requirement",
      "section_path": [
        "Dataset Completeness",
        "Requirements"
      ],
      "block": {
