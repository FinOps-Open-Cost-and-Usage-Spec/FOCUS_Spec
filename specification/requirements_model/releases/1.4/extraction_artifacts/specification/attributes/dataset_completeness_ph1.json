      },
      "provenance": {
        "line_start": 15,
        "line_end": 15
      },
      "_alignment_status": "confirmed",
      "ref": "L015"
    },
    {
      "temp_id": "R007",
      "order": 7,
      "text": "*FOCUS dataset* SHOULD exclude *custom columns* that duplicate information already captured in *FOCUS columns*, except during a transitional period as defined in publicly-available documentation, to enable migration without breaking changes.",
      "keyword": "SHOULD",
      "role": "requirement",
      "section_path": [
        "Dataset Completeness",
        "Requirements"
      ],
      "block": {
        "block_type": "list_item",
        "indent_level": 1,
        "bullet": "*"
